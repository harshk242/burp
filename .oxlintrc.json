{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "react"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "error"
  },
  "env": {
    "builtin": true,
    "es2024": true,
    "node": true
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/coverage/**",
    "app/web/next-env.d.ts",
    "bio-agent/**"
  ],
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-base-to-string": "error",
    "typescript/ban-ts-comment": ["error", { "ts-expect-error": "allow-with-description", "minimumDescriptionLength": 10 }],
    "typescript/switch-exhaustiveness-check": ["error", { "considerDefaultExhaustiveForUnions": true }],
    "typescript/only-throw-error": "error",
    "typescript/prefer-promise-reject-errors": ["error", { "allowThrowingAny": true, "allowThrowingUnknown": true }],
    "typescript/return-await": ["error", "in-try-catch"],
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "typescript/restrict-template-expressions": "off",
    "typescript/no-unsafe-type-assertion": "off",

    "eslint/no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrorsIgnorePattern": "^_", "ignoreRestSiblings": true }
    ],

    "eslint/no-shadow": "off",
    "eslint/no-underscore-dangle": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-array-sort": "off",
    "unicorn/no-array-reverse": "off",
    "unicorn/prefer-add-event-listener": "off",
    "typescript/consistent-return": "off",
    "import/no-named-as-default-member": "off",

    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }]
  },
  "overrides": [
    {
      "files": ["**/__tests__/**", "**/__test-utils__/**", "**/*.test.ts", "**/*.contract.ts"],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    },
    {
      "files": ["**/__tests__/**", "**/__test-utils__/**"],
      "plugins": ["vitest"],
      "rules": {
        "vitest/valid-expect": ["error", { "maxArgs": 2 }],
        "vitest/expect-expect": ["error", { "assertFunctionNames": ["expect", "expect*", "assert*"] }],
        "vitest/valid-title": "off",
        "vitest/no-conditional-expect": "off",
        "vitest/require-mock-type-parameters": "off",
        "vitest/require-to-throw-message": "off"
      }
    },
    {
      "files": ["app/**/__tests__/**", "app/**/*.test.ts"],
      "rules": {
        "typescript/await-thenable": "off",
        "typescript/no-floating-promises": [
          "error",
          { "allowForKnownSafeCalls": [{ "from": "package", "package": "bun:test", "name": "module" }] }
        ]
      }
    },
    {
      "files": ["mcp-server/src/platforms/**/__tests__/**"],
      "plugins": ["vitest"],
      "rules": {
        "vitest/expect-expect": [
          "error",
          {
            "assertFunctionNames": ["expect", "expect*", "assert*", "capture", "invoke"],
            "additionalTestBlockFunctions": ["chemblContractTest", "clinicalTrialsContractTest", "clinpgxContractTest", "clinvarContractTest", "ensemblContractTest", "openTargetsContractTest", "pubchemContractTest", "pubmedContractTest", "reactomeContractTest", "uniprotContractTest"]
          }
        ],
        "vitest/no-standalone-expect": ["error", { "additionalTestBlockFunctions": ["chemblContractTest", "clinicalTrialsContractTest", "clinpgxContractTest", "clinvarContractTest", "ensemblContractTest", "openTargetsContractTest", "pubchemContractTest", "pubmedContractTest", "reactomeContractTest", "uniprotContractTest"] }]
      }
    }
  ]
}
