{
  "type": "array",
  "path": "$",
  "items": {
    "type": "object",
    "path": "$[]",
    "properties": {
      "dbname": {
        "type": "string",
        "path": "$[].dbname"
      },
      "synonyms": {
        "type": "array",
        "path": "$[].synonyms",
        "items": {
          "type": "string",
          "path": "$[].synonyms[]"
        }
      },
      "db_display_name": {
        "type": "string",
        "path": "$[].db_display_name"
      },
      "info_text": {
        "type": "string",
        "path": "$[].info_text"
      },
      "info_type": {
        "type": "string",
        "path": "$[].info_type"
      },
      "primary_id": {
        "type": "string",
        "path": "$[].primary_id"
      },
      "description": {
        "type": "union",
        "path": "$[].description",
        "variants": [
          {
            "type": "string",
            "path": "$[].description"
          },
          {
            "type": "null",
            "path": "$[].description"
          }
        ]
      },
      "display_id": {
        "type": "string",
        "path": "$[].display_id"
      },
      "version": {
        "type": "string",
        "path": "$[].version"
      }
    }
  }
}
