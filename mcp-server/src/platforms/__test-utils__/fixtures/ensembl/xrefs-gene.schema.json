{
  "type": "array",
  "path": "$",
  "items": {
    "type": "object",
    "path": "$[]",
    "properties": {
      "dbname": {
        "type": "string",
        "path": "$[].dbname"
      },
      "info_type": {
        "type": "string",
        "path": "$[].info_type"
      },
      "synonyms": {
        "type": "array",
        "path": "$[].synonyms",
        "items": {
          "type": "string",
          "path": "$[].synonyms[]"
        }
      },
      "info_text": {
        "type": "string",
        "path": "$[].info_text"
      },
      "display_id": {
        "type": "string",
        "path": "$[].display_id"
      },
      "description": {
        "type": "unknown",
        "path": "$[].description"
      },
      "primary_id": {
        "type": "string",
        "path": "$[].primary_id"
      },
      "version": {
        "type": "string",
        "path": "$[].version"
      },
      "db_display_name": {
        "type": "string",
        "path": "$[].db_display_name"
      }
    }
  }
}
