{
  "name": "burp",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot server/index.ts",
    "start": "bun run server/index.ts",
    "db:migrate": "bun run server/db/cli/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:check": "drizzle-kit check",
    "db:drift": "drizzle-kit generate && git diff --exit-code -- server/db/migrations && git status --porcelain -- server/db/migrations | (! grep .)",
    "db:verify": "bun run server/db/cli/verify.ts",
    "db:snapshot": "bun run server/db/cli/snapshot.ts",
    "db:studio": "drizzle-kit studio",
    "generate:embeddings": "bun run scripts/generate-tool-embeddings.ts",
    "gate:prompt-cache": "DATABASE_URL=:memory: bun scripts/prompt-cache-gate/phase0-gate.ts",
    "eval:sync": "bun run evals/sync.ts",
    "eval": "bun run evals/run.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.78",
    "@ai-sdk/google": "^4.0.93",
    "@ai-sdk/openai": "^4.0.91",
    "@clerk/backend": "^2.29.5",
    "@hono/swagger-ui": "^0.5.0",
    "@hono/zod-openapi": "^0.18.0",
    "@langfuse/client": "5.13.1",
    "@langfuse/otel": "5.13.1",
    "@langfuse/tracing": "5.13.1",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/otlp-exporter-base": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "ai": "^7.0.137",
    "drizzle-orm": "0.45.4",
    "hono": "^4.6.0",
    "node-jq": "^6.3.1",
    "uuid": "^11.0.0",
    "yaml": "^2.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@libsql/client": "0.18.0",
    "@types/bun": "^1.1.0",
    "@types/uuid": "^10.0.0",
    "bun-types": "^1.3.11",
    "drizzle-kit": "0.31.11",
    "typescript": "^5.9.3"
  }
}
