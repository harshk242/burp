{
  "name": "burp",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot server/index.ts",
    "start": "bun run server/index.ts",
    "db:migrate": "bun run server/db/cli/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:check": "drizzle-kit check",
    "db:drift": "drizzle-kit generate && git diff --exit-code -- server/db/migrations && git status --porcelain -- server/db/migrations | (! grep .)",
    "db:verify": "bun run server/db/cli/verify.ts",
    "db:snapshot": "bun run server/db/cli/snapshot.ts",
    "db:studio": "drizzle-kit studio",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.64",
    "@ai-sdk/google": "^3.0.53",
    "@clerk/backend": "^2.29.5",
    "@hono/swagger-ui": "^0.5.0",
    "@hono/zod-openapi": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ai": "^6.0.141",
    "drizzle-orm": "0.45.4",
    "hono": "^4.6.0",
    "node-jq": "^6.3.1",
    "uuid": "^11.0.0",
    "yaml": "^2.8.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@libsql/client": "0.18.0",
    "@types/bun": "^1.1.0",
    "@types/uuid": "^10.0.0",
    "bun-types": "^1.3.11",
    "drizzle-kit": "0.31.11",
    "typescript": "^5.9.3"
  }
}
