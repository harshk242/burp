# ============================================================
# BURP — Secrets
# Copy to .env and fill in values.
# Non-secret configuration (LLM model, ports, tool search
# tuning, platform toggles, etc.) lives in config.yaml.
# ============================================================

# === LLM API Keys ===
# Required for Anthropic provider (default)
ANTHROPIC_API_KEY=sk-ant-...
# Required for the Google chat provider, or for embedding.provider: google
# GEMINI_API_KEY=

# === Embeddings (semantic tool search) ===
# Required for the default embedding provider (OpenAI text-embedding-3-small).
# Without the configured provider's key, tool search is keyword-only and makes
# no embedding calls. With it, the server builds and updates the index
# (tool_search.embeddings_path) in the background on boot. Provider/model live
# in config.yaml (`embedding:`). In production: fly secrets set OPENAI_API_KEY=...
# OPENAI_API_KEY=
# Opt out of the background index sync (e.g. no outbound calls): "false" or "0"
# EMBEDDING_SYNC_ON_BOOT=false

# === Authentication ===
# Clerk — https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_...
AUTH_MODE=clerk

# Optional: backend-only authentication for local coding agents.
# Generate with: openssl rand -hex 32
# Disabled when NODE_ENV=production. Keep this value local and secret.
# Set DEV_AGENT_EMAIL to your own signed-in account email to have agent chats
# appear in your frontend session list; otherwise a separate dev user is used.
# DEV_AGENT_TOKEN=
# DEV_AGENT_EMAIL=dev-agent@example.com

# === Optional ===
# NCBI — raises rate limits for ClinVar/PubMed tools
# https://www.ncbi.nlm.nih.gov/account/
# NCBI_API_KEY=

# User with this email is auto-promoted to admin on first sign-in
# ADMIN_EMAIL=you@example.com
