# ============================================================
# BURP — Secrets
# Copy to .env and fill in values.
# Non-secret configuration (LLM model, ports, tool search
# tuning, platform toggles, etc.) lives in config.yaml.
# ============================================================

# === LLM API Keys ===
# Required for Anthropic provider (default)
ANTHROPIC_API_KEY=sk-ant-...
# Required for Google provider + embedding-based tool search
# GEMINI_API_KEY=

# === Authentication ===
# Clerk — https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_...

# Optional: backend-only authentication for local coding agents.
# Generate with: openssl rand -hex 32
# Disabled when NODE_ENV=production. Keep this value local and secret.
# DEV_AGENT_TOKEN=
# DEV_AGENT_EMAIL=dev-agent@example.com

# === Optional ===
# NCBI — raises rate limits for ClinVar/PubMed tools
# https://www.ncbi.nlm.nih.gov/account/
# NCBI_API_KEY=

# User with this email is auto-promoted to admin on first sign-in
# ADMIN_EMAIL=you@example.com
