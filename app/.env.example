# ============================================================
# Super Bio Agent — Server Environment Variables
# Copy to .env and fill in values
# ============================================================

# === LLM Provider ===
# "google" | "anthropic" (default: anthropic)
LLM_PROVIDER=anthropic
# LLM_CHAT_MODEL=claude-haiku-4-5         # or gemini-3-flash-preview
# LLM_TITLE_MODEL=claude-haiku-4-5
# LLM_SUMMARIZER_MODEL=claude-haiku-4-5
# LLM_MAX_RETRIES=3
# TOOL_OUTPUT_SUMMARY_THRESHOLD=15000

# === API Keys ===
# Required for Anthropic provider
ANTHROPIC_API_KEY=sk-ant-...
# Required for Google provider + embedding-based tool search
# GEMINI_API_KEY=

# === Feature Flags ===
# Set to "false" to revert to legacy Anthropic-only orchestration
# USE_VERCEL_AI=true

# Clerk (required) — https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_...

# NCBI (optional, but raises rate limits for ClinVar/PubMed)
# https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=

# Database path (optional, defaults to ./data/super-bio-agent.db)
# DATABASE_URL=./data/super-bio-agent.db

# MCP servers base directory (optional, defaults to ../mcp-servers)
# Set to /app/servers when running inside Docker
# MCP_SERVERS_BASE=../mcp-servers

# Server port (optional, defaults to 3000)
# PORT=3000

# Admin email — user with this email is auto-promoted to admin on first sync (optional)
# ADMIN_EMAIL=you@example.com

# Comma-separated list of allowed CORS origins (optional)
# Also used by the Next.js dev server as allowedDevOrigins (scheme is stripped automatically).
# Add your Tailscale IP here to access from other devices on the network.
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://<tailscale-ip>:3001

# === Tool Search Tuning (optional) ===
# TOOL_SEARCH_BM25_WEIGHT=1.0
# TOOL_SEARCH_SEMANTIC_WEIGHT=1.0
# TOOL_SEARCH_SHORT_QUERY_THRESHOLD=4     # Queries with ≤ N words bias toward BM25
# TOOL_SEARCH_SHORT_QUERY_BM25_WEIGHT=2.0 # BM25 weight multiplier for short queries
# TOOL_SEARCH_TOP_K=15

# === Legacy env vars (still supported as fallbacks) ===
# CLAUDE_MODEL, CLAUDE_TITLE_MODEL, TOOL_SUMMARIZER_MODEL
